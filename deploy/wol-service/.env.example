# MAC address of d3r-ser (the box that hosts Ollama).
WOL_MAC=70:70:fc:04:ed:fa

# Broadcast address for your LAN. 192.168.1.255 is the usual one for a
# 192.168.1.0/24 home network. Adjust if your subnet differs.
WOL_BROADCAST=192.168.1.255

# HTTP port the service listens on (host port — host networking is used).
WOL_PORT=9999
