# Copy to .env and fill in. Never commit the real .env.
#
# JWT_SECRET — used by Postiz to sign session cookies. Generate with:
#   openssl rand -base64 48
POSTIZ_JWT_SECRET=changeme-base64-48

# Database password (auto-created on first run). Generate with:
#   openssl rand -hex 24
POSTIZ_DB_PASSWORD=changeme-hex-24
