{
  "name": "Marketing Team — EN Stream",
  "nodes": [
    {
      "parameters": {
        "rule": {"interval": [{"field": "cronExpression", "expression": "0 10,22 * * *"}]}
      },
      "id": "mt-en-trigger-001",
      "name": "Twice daily (10:00 / 22:00 CST)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://100.84.156.15:8400/api/wake-ollama",
        "options": {"timeout": 60000}
      },
      "id": "mt-en-wake-010",
      "name": "Wake d3r-ser (Ollama)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [360, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://100.84.156.15:8400/api/drafts",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {"name": "status", "value": "awaiting-user"},
            {"name": "limit", "value": "50"}
          ]
        },
        "options": {"timeout": 30000}
      },
      "id": "mt-en-fetch-002",
      "name": "Fetch awaiting-user drafts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300]
    },
    {
      "parameters": {"fieldToSplitOut": "items", "options": {}},
      "id": "mt-en-split-003",
      "name": "Split drafts",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [700, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {"caseSensitive": true, "typeValidation": "loose"},
          "conditions": [
            {"leftValue": "={{ $json.metadata.lang }}", "rightValue": "en", "operator": {"type": "string", "operation": "equals"}}
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "mt-en-filter-004",
      "name": "Only lang=en",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_CHAT_ID_EN }}",
        "text": "=📝 *Draft EN — {{ $json.metadata.platform.toUpperCase() }}*\n\n*Source:* {{ $json.metadata.item_source }}\n*Verdict:* {{ $json.metadata.edu_verdict }}\n*Edu notes:* _{{ $json.metadata.edu_reasoning }}_\n\n```\n{{ $json.document }}\n```",
        "additionalFields": {
          "parse_mode": "Markdown",
          "reply_markup": "={\n  \"inline_keyboard\": [[\n    { \"text\": \"✅ Approve\", \"callback_data\": \"approve_{{ $json.id }}\" },\n    { \"text\": \"✏️ Edit\", \"callback_data\": \"edit_{{ $json.id }}\" },\n    { \"text\": \"⏭️ Skip\", \"callback_data\": \"skip_{{ $json.id }}\" }\n  ]]\n}"
        }
      },
      "id": "mt-en-tg-005",
      "name": "Send to EN Telegram inbox",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1140, 300],
      "credentials": {
        "telegramApi": {"id": "PLACEHOLDER_TELEGRAM_CRED_ID", "name": "Telegram Marketing Bot"}
      }
    }
  ],
  "connections": {
    "Twice daily (10:00 / 22:00 CST)": {"main": [[{"node": "Wake d3r-ser (Ollama)", "type": "main", "index": 0}]]},
    "Wake d3r-ser (Ollama)": {"main": [[{"node": "Fetch awaiting-user drafts", "type": "main", "index": 0}]]},
    "Fetch awaiting-user drafts": {"main": [[{"node": "Split drafts", "type": "main", "index": 0}]]},
    "Split drafts": {"main": [[{"node": "Only lang=en", "type": "main", "index": 0}]]},
    "Only lang=en": {"main": [[{"node": "Send to EN Telegram inbox", "type": "main", "index": 0}]]}
  },
  "active": false,
  "settings": {"executionOrder": "v1", "saveDataErrorExecution": "all", "saveDataSuccessExecution": "all", "saveManualExecutions": true},
  "versionId": "2",
  "meta": {"description": "EN stream — surfaces drafts that Edu approved-for-review to a dedicated Telegram chat. Buttons call observatory's draft-lifecycle endpoints."}
}
