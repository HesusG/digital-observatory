{
  "name": "Marketing Team — Telegram Callback Handler",
  "nodes": [
    {
      "parameters": {
        "updates": ["callback_query"],
        "additionalFields": {}
      },
      "id": "mt-cb-trigger-001",
      "name": "Telegram callback trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [240, 300],
      "credentials": {
        "telegramApi": {"id": "PLACEHOLDER_TELEGRAM_CRED_ID", "name": "Telegram Marketing Bot"}
      },
      "notes": "Fires on inline-button taps from marketing-team-es and -en. callback_data shape: approve_<draft_id> | edit_<draft_id> | skip_<draft_id>."
    },
    {
      "parameters": {
        "jsCode": "const cb = $input.first().json.callback_query;\nconst data = (cb && cb.data) || '';\nconst [action, ...rest] = data.split('_');\nconst id = rest.join('_');\nreturn [{ json: { action, draft_id: id, chat_id: cb.message.chat.id, callback_query_id: cb.id, original_message_id: cb.message.message_id, original_text: cb.message.text } }];"
      },
      "id": "mt-cb-parse-002",
      "name": "Parse callback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {"caseSensitive": true, "typeValidation": "loose"},
                "conditions": [
                  {"leftValue": "={{ $json.action }}", "rightValue": "approve", "operator": {"type": "string", "operation": "equals"}}
                ],
                "combinator": "and"
              },
              "outputKey": "approve"
            },
            {
              "conditions": {
                "options": {"caseSensitive": true, "typeValidation": "loose"},
                "conditions": [
                  {"leftValue": "={{ $json.action }}", "rightValue": "skip", "operator": {"type": "string", "operation": "equals"}}
                ],
                "combinator": "and"
              },
              "outputKey": "skip"
            },
            {
              "conditions": {
                "options": {"caseSensitive": true, "typeValidation": "loose"},
                "conditions": [
                  {"leftValue": "={{ $json.action }}", "rightValue": "edit", "operator": {"type": "string", "operation": "equals"}}
                ],
                "combinator": "and"
              },
              "outputKey": "edit"
            }
          ]
        },
        "options": {"allMatchingOutputs": false}
      },
      "id": "mt-cb-switch-003",
      "name": "Route by action",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://100.84.156.15:8400/api/drafts/{{ $('Parse callback').item.json.draft_id }}/approve",
        "options": {"timeout": 30000}
      },
      "id": "mt-cb-approve-004",
      "name": "Approve via observatory",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 200],
      "notes": "Calls observatory's /api/drafts/{id}/approve. Pablo handles the Postiz hop server-side; n8n stays naive."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://100.84.156.15:8400/api/drafts/{{ $('Parse callback').item.json.draft_id }}/skip",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [{"name": "reason", "value": "user-skip"}]
        },
        "options": {"timeout": 15000}
      },
      "id": "mt-cb-skip-005",
      "name": "Skip via observatory",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 360]
    },
    {
      "parameters": {
        "chatId": "={{ $('Parse callback').item.json.chat_id }}",
        "text": "=✏️ Edit mode: reply to this message with the replacement post text. (Not wired in v1 — open the matching draft in Obsidian, edit there, then re-approve.)"
      },
      "id": "mt-cb-edit-006",
      "name": "Edit notice",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [900, 500],
      "credentials": {
        "telegramApi": {"id": "PLACEHOLDER_TELEGRAM_CRED_ID", "name": "Telegram Marketing Bot"}
      }
    },
    {
      "parameters": {
        "operation": "answerCallback",
        "callbackQueryId": "={{ $('Parse callback').item.json.callback_query_id }}",
        "additionalFields": {"text": "Got it", "show_alert": false}
      },
      "id": "mt-cb-ack-007",
      "name": "Acknowledge callback",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1140, 300],
      "credentials": {
        "telegramApi": {"id": "PLACEHOLDER_TELEGRAM_CRED_ID", "name": "Telegram Marketing Bot"}
      }
    }
  ],
  "connections": {
    "Telegram callback trigger": {"main": [[{"node": "Parse callback", "type": "main", "index": 0}]]},
    "Parse callback": {"main": [[{"node": "Route by action", "type": "main", "index": 0}]]},
    "Route by action": {
      "main": [
        [{"node": "Approve via observatory", "type": "main", "index": 0}],
        [{"node": "Skip via observatory", "type": "main", "index": 0}],
        [{"node": "Edit notice", "type": "main", "index": 0}]
      ]
    },
    "Approve via observatory": {"main": [[{"node": "Acknowledge callback", "type": "main", "index": 0}]]},
    "Skip via observatory": {"main": [[{"node": "Acknowledge callback", "type": "main", "index": 0}]]},
    "Edit notice": {"main": [[{"node": "Acknowledge callback", "type": "main", "index": 0}]]}
  },
  "active": false,
  "settings": {"executionOrder": "v1", "saveDataErrorExecution": "all", "saveDataSuccessExecution": "all", "saveManualExecutions": true},
  "versionId": "2",
  "meta": {"description": "Handles Approve / Edit / Skip callbacks. All three call observatory's draft-lifecycle endpoints; Pablo handles the Postiz hop. Edit is a manual notice in Slice 1 (open the Obsidian markdown, change it, re-approve)."}
}
